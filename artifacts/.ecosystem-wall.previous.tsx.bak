                <LogoNode src={logoOracle} alt="Oracle" size="xs" opacity={0.28} />
              </motion.div>
            </DepthNode>

            {/* ── Âncora central — DevClub como hub ───────────────────── */}
            <DepthNode {...depthProps} strength={0.08} className="top-[50%] left-1/2 -translate-x-1/2 -translate-y-1/2">
              <motion.div
                initial={reducedMotion ? false : { opacity: 0, scale: 0.92 }}
                animate={isInView ? { opacity: 1, scale: 1 } : undefined}
                transition={{ duration: 0.8, delay: 0.45, ease: motionTokens.easing.emphasized }}
                className="ecosystem-hub"
              >
                <div className="ecosystem-hub__glow" />
                <img
                  src={logoDevClub}
                  alt=""
                  className="h-10 w-auto opacity-[0.82]"
                  draggable={false}
                />
                <MonoLabel>Hub · DevClub</MonoLabel>
              </motion.div>
            </DepthNode>

            {/* Fade de borda — integra ao fundo */}
            <div
              aria-hidden="true"
              className="pointer-events-none absolute inset-0"
              style={{
                background:
                  "linear-gradient(to right, #040810 0%, transparent 8%, transparent 92%, #040810 100%), linear-gradient(to bottom, #040810 0%, transparent 6%, transparent 94%, #040810 100%)",
              }}
            />
          </div>
        </div>
      </div>

      {/* Fade de transição inferior */}
      <div
        aria-hidden="true"
        className="pointer-events-none absolute inset-x-0 bottom-0 h-20 bg-gradient-to-b from-transparent to-neutral-950"
      />
    </section>
  );
}

// ─────────────────────────────────────────────────────────────────────────────
// DataPill — indicador editorial
// ─────────────────────────────────────────────────────────────────────────────

function DataPill({
  value,
  label,
  accent = "cyan",
}: {
  value: string;
  label: string;
  accent?: "cyan" | "violet" | "emerald";
}) {
  const colors = {
    cyan: {
      value: "rgba(103,232,249,0.88)",
      label: "rgba(207,250,254,0.46)",
      line: "rgba(103,232,249,0.52)",
    },
    violet: {
      value: "rgba(167,139,250,0.88)",
      label: "rgba(196,181,253,0.46)",
      line: "rgba(167,139,250,0.52)",
    },
    emerald: {
      value: "rgba(110,231,183,0.88)",
      label: "rgba(167,243,208,0.46)",
      line: "rgba(110,231,183,0.52)",
    },
  };

  const c = colors[accent];

  return (
    <div className="ecosystem-data-pill">
      <span
        className="ecosystem-data-pill__line"
        style={{ background: c.line }}
        aria-hidden="true"
      />
      <span
        className="ecosystem-data-pill__value"
        style={{ color: c.value }}
      >
        {value}
      </span>
      <span
        className="ecosystem-data-pill__label"
        style={{ color: c.label }}
      >
        {label}
      </span>
    </div>
  );
}
