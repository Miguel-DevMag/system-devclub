              >
                <LogoNode src={logoMongoDB} alt="MongoDB" size="xs" opacity={0.42} />
              </motion.div>
            </DepthNode>

            {/* Notion */}
            <DepthNode {...depthProps} strength={0.16} className="top-[70%] left-[30%]">
              <motion.div
                initial={reducedMotion ? false : { opacity: 0 }}
                animate={isInView ? { opacity: 1 } : undefined}
