            </DepthNode>

            {/* ── Zona D — Base: mercado corporativo ──────────────────── */}

            <motion.div
              initial={reducedMotion ? false : { opacity: 0 }}
              animate={isInView ? { opacity: 1 } : undefined}
              transition={{ duration: 0.5, delay: 0.62 }}
              className="ecosystem-zone-label"
              style={{ top: "79%", left: "7%" }}
            >
              <span className="ecosystem-zone-label__tick" style={{ background: "rgba(110,231,183,0.56)" }} />
