            </DepthNode>

            {/* Nubank */}
            <DepthNode {...depthProps} strength={0.18} className="top-[88%] left-[70%]">
              <motion.div
                initial={reducedMotion ? false : { opacity: 0 }}
                animate={isInView ? { opacity: 1 } : undefined}
