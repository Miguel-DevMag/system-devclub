            {/* Databricks */}
            <DepthNode {...depthProps} strength={0.18} className="top-[71%] left-[62%]">
              <motion.div
                initial={reducedMotion ? false : { opacity: 0 }}
                animate={isInView ? { opacity: 1 } : undefined}
                transition={{ duration: 0.5, delay: 0.75 }}
              >
                <LogoNode src={logoDatabricks} alt="Databricks" size="xs" opacity={0.34} />
